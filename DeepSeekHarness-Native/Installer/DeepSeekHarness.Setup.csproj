<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeepSeekHarness.Setup</AssemblyName>
    <RootNamespace>DeepSeekHarness.Setup</RootNamespace>
    <ApplicationIcon>app-icon.ico</ApplicationIcon>
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload\DeepSeekHarness-Distribution.zip" />
    <Resource Include="app-icon.ico" />
  </ItemGroup>
</Project>

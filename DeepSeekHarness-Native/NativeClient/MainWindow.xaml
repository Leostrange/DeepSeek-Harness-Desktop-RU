<Window x:Class="DeepSeekHarness.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DeepSeek Harness" Width="1280" Height="820" MinWidth="960" MinHeight="620"
        Background="#101114" WindowStartupLocation="CenterScreen" Icon="/app-icon.ico">
  <Window.Resources>
    <!-- Тёмная кнопка для панели обновления (дефолтная WPF — белая) -->
    <Style x:Key="BarBtn" TargetType="Button">
      <Setter Property="Background" Value="#252A33"/>
      <Setter Property="Foreground" Value="#F1F3F5"/>
      <Setter Property="BorderBrush" Value="#30343D"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2E3440"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ═══ Панель обновления (скрыта по умолчанию) ═══ -->
    <Border x:Name="UpdateBar" Grid.Row="0" Background="#1A2332" BorderBrush="#30343D"
            BorderThickness="0,0,0,1" Padding="16,10" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="UpdateStatus" Text="Доступно обновление" FontSize="13"
                       Foreground="#F1F3F5" VerticalAlignment="Center"/>
            <TextBlock x:Name="UpdateVersion" Text="" FontSize="13" Foreground="#4A9EFF"
                       Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <!-- Прогресс-бар (скрыт до начала обновления) -->
          <Border x:Name="UpdateProgressTrack" Background="#20232A" CornerRadius="3"
                  Height="4" Margin="0,8,0,0" Visibility="Collapsed">
            <Border x:Name="UpdateProgressFill" Background="#4A9EFF" CornerRadius="3"
                    HorizontalAlignment="Left" Width="0"/>
          </Border>
          <TextBlock x:Name="UpdateDetail" Text="" FontSize="11" Foreground="#6B7280"
                     Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="UpdateBtn" Content="Обновить" Click="Update_Click"
                  Style="{StaticResource BarBtn}"
                  Background="#4A9EFF" Foreground="#101114" FontWeight="SemiBold"
                  Padding="16,6" FontSize="12" Margin="0,0,8,0"/>
          <Button x:Name="UpdateDismissBtn" Content="X" Click="UpdateDismiss_Click"
                  Style="{StaticResource BarBtn}"
                  Background="Transparent" Foreground="#6B7280"
                  Padding="8,4" FontSize="11" FontWeight="Bold"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ WebView + кнопка updater ═══ -->
    <Grid Grid.Row="1">
      <wv2:WebView2 x:Name="WebView"/>
      <!-- Плавающая кнопка обновления в правом нижнем углу -->
      <Button x:Name="UpdaterFab" Content="&#x21BB;" Click="UpdaterFab_Click"
              Style="{StaticResource BarBtn}"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,16,16" Width="40" Height="40"
              Background="#1A2332" Foreground="#4A9EFF" FontSize="18"
              ToolTip="Проверить обновления DeepSeek Harness"/>
    </Grid>
  </Grid>
</Window>
